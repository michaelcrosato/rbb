{
  "name": "rbb",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:client": "npm run typecheck && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start:server": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:install": "playwright install --with-deps chromium",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:rendering": "tsx scripts/benchmark-rendering.ts",
    "check": "npm run typecheck && npm run lint && npm test && vite build && npm run build:server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "three": "0.186.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
